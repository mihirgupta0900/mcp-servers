# clickhouse-readonly-mcp credentials
# Copy to .env (same folder) and fill in. .env is gitignored.
# Both environments are configured at once; tools pick one via the `env` param.

# ---------- prod ----------
CLICKHOUSE_PROD_HOST=abc123.ap-south-1.aws.clickhouse.cloud
CLICKHOUSE_PROD_USER=default
CLICKHOUSE_PROD_PASSWORD=change-me

# HTTPS on 8443 (ClickHouse Cloud) is the default. For a self-managed server
# over plain HTTP, set SECURE=0 — the port then defaults to 8123.
#CLICKHOUSE_PROD_SECURE=1
#CLICKHOUSE_PROD_PORT=8443
# Default database for unqualified table names. Default: default
#CLICKHOUSE_PROD_DATABASE=default
#CLICKHOUSE_PROD_TIMEOUT_MS=30000

# ---------- stag ----------
CLICKHOUSE_STAG_HOST=def456.ap-south-1.aws.clickhouse.cloud
CLICKHOUSE_STAG_USER=default
CLICKHOUSE_STAG_PASSWORD=change-me

#CLICKHOUSE_STAG_SECURE=1
#CLICKHOUSE_STAG_PORT=8443
#CLICKHOUSE_STAG_DATABASE=default
#CLICKHOUSE_STAG_TIMEOUT_MS=30000

# ---------- more clusters in one environment ----------
# An environment can hold several ClickHouse clusters (separate services, each
# with its own data). The un-prefixed CLICKHOUSE_<ENV>_* set above is the env's
# default cluster; name it so it can also be selected explicitly:
#CLICKHOUSE_PROD_CLUSTER_NAME=cluster_1
#
# Each extra cluster uses CLICKHOUSE_<ENV>_<CLUSTER>_*, with the same optional
# keys (SECURE, PORT, DATABASE, TIMEOUT_MS). Tools select it with cluster: "cluster_2".
# add-cluster-from-ssm.sh writes these lines from SSM.
#CLICKHOUSE_PROD_CLUSTER_2_HOST=ghi789.ap-south-1.aws.clickhouse.cloud
#CLICKHOUSE_PROD_CLUSTER_2_USER=default
#CLICKHOUSE_PROD_CLUSTER_2_PASSWORD=change-me
#CLICKHOUSE_PROD_CLUSTER_2_DATABASE=default
