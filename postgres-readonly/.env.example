# postgres-readonly-mcp credentials
# Copy to .env (same folder) and fill in. .env is gitignored.
# Both environments are configured at once; tools pick one via the `env` param.

# ---------- prod ----------
PG_PROD_HOST=prod-db.example.com
PG_PROD_PORT=5432
PG_PROD_USER=readonly_user
PG_PROD_PASSWORD=change-me

# Database used for the initial/admin connection (list_databases). Default: postgres
#PG_PROD_DATABASE=postgres
# disable | require (default, encrypts without cert verification) | verify-full
#PG_PROD_SSL=require
#PG_PROD_SSL_CA=/absolute/path/to/ca.pem
#PG_PROD_STATEMENT_TIMEOUT_MS=15000
# Set to 1 only if your pooler (e.g. PgBouncer transaction mode) rejects startup options
#PG_PROD_NO_STARTUP_OPTIONS=0

# ---------- stag ----------
PG_STAG_HOST=stag-db.example.com
PG_STAG_PORT=5432
PG_STAG_USER=readonly_user
PG_STAG_PASSWORD=change-me

#PG_STAG_DATABASE=postgres
#PG_STAG_SSL=require
#PG_STAG_SSL_CA=/absolute/path/to/ca.pem
#PG_STAG_STATEMENT_TIMEOUT_MS=15000
#PG_STAG_NO_STARTUP_OPTIONS=0
